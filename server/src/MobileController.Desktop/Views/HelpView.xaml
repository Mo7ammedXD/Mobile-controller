<UserControl x:Class="MobileController.Desktop.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,4,20,20" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Help" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageIntro}"
                       Text="Mobile Controller turns phones into game controllers. Each phone appears to Windows as a real Xbox 360 controller (or a DualShock 4), so any game with controller support works without setup." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="The phone does not find the PC" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="•  The phone and the PC must be on the same network. Guest Wi-Fi and some routers keep devices apart: try USB tethering (phone plugged in by USB, then Settings > Network > Hotspot &amp; tethering > USB tethering)." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Windows Firewall may block the phone: use Allow phones in the setup checklist on the Dashboard." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Searching does not work on every network; type the address and port from the Connect a phone page into the phone instead." />
                    <TextBlock TextWrapping="Wrap" Text="•  On Android 17 and later, allow Mobile Controller to use the local network when the phone asks." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="The phone is connected but the game does not react" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Is the controller driver (ViGEmBus) installed? The setup checklist says so; Diagnostics > Test as Xbox 360 shows a controller that moves by itself." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="•  A phone set to DualShock 4 is invisible to games that only support Xbox controllers: switch it to Xbox 360 on the Controllers page." />
                    <TextBlock TextWrapping="Wrap" Text="•  Some games only use the first controller: disconnect other controllers, or pick the player in the game." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="It lags or stutters" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="•  Look at the link quality on the Controllers and Diagnostics pages. Lost packets and long gaps come from the Wi-Fi: move closer to the router, use 5 GHz, or switch to USB tethering (the best link)." />
                    <TextBlock TextWrapping="Wrap" Text="•  On the phone, keep the send rate at 120 Hz and turn off battery saver while playing." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Links" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="ViGEmBus driver download" Command="{Binding InstallDriverCommand}" Margin="0,0,8,0" Padding="12,5" />
                        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" Padding="12,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding ServerVersionText}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
