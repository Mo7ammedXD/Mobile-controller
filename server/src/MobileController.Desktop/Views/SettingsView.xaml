<UserControl x:Class="MobileController.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,4,20,20" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageIntro}"
                           Text="Server settings take effect when you save (the server restarts; phones reconnect by themselves). The defaults suit almost everyone." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Name phones see" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Name phones see" />
                        <TextBlock Style="{StaticResource Caption}" Text="Shown in the phone's list of PCs. Empty: this computer's name." />
                        <TextBlock Text="UDP port" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="UDP port" />
                        <TextBlock Style="{StaticResource Caption}" Text="24680 unless another program needs it. Phones that were typed in by hand need the same port." />
                        <TextBlock Text="Listen address" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding Bind, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Listen address" />
                        <TextBlock Style="{StaticResource Caption}" Text="Empty: every network adapter. Enter one of this PC's addresses to accept phones on that network only." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Controllers" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Phones appear as" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding OutputChoices}" SelectedItem="{Binding DefaultOutput}" Width="200" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Phones appear as" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="xbox360 works in every PC game with controller support. ds4 (DualShock 4) shows PlayStation prompts in games and Steam that support it, but games that only use XInput do not see it. A phone can ask for its own, and the Controllers page sets it per phone." />
                        <TextBlock Text="Maximum controllers" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding MaxPads, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="Maximum controllers" />
                        <TextBlock Style="{StaticResource Caption}" Text="1 to 8. XInput games see at most 4." />
                        <TextBlock Text="Release all inputs after (ms without input)" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding NeutralTimeout, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Release all inputs after" />
                        <TextBlock Style="{StaticResource Caption}" Text="If a phone goes quiet (screen off, Wi-Fi hiccup), its buttons and sticks are let go after this long, so nothing stays held." />
                        <TextBlock Text="Unplug a controller after (ms without any packet)" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding DisconnectTimeout, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Unplug after" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Allowed phones" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding Allow, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"
                                 AutomationProperties.Name="Allowed phone addresses" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="One phone address per line. Empty: any phone on your network may connect. Anyone on the network can drive a controller otherwise, so list your phones on shared networks." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Privacy and performance" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Tell phones which game is in front" IsChecked="{Binding GameDetect}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="26,2,0,8"
                                   Text="Phones then switch to the right layout by themselves. Only the program's file name (e.g. rocketleague.exe) is sent, to connected phones only. Off: the foreground window is never looked at." />
                        <CheckBox Content="Run the server at high priority" IsChecked="{Binding HighPriority}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="26,2,0,8"
                                   Text="Can help on a PC that is busy while you play (streaming, recording)." />
                        <CheckBox Content="Write link statistics to the log every 5 seconds" IsChecked="{Binding Verbose}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="This app" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                        <CheckBox Content="…and stay in the notification area" IsChecked="{Binding StartMinimized}" Margin="26,6,0,0"
                                  IsEnabled="{Binding StartWithWindows}" />
                        <CheckBox Content="Closing the window keeps phones working (notification area)" IsChecked="{Binding CloseToTray}" Margin="0,6,0,0" />
                        <CheckBox Content="Notify me when a phone connects or leaves" IsChecked="{Binding Notifications}" Margin="0,6,0,0" />
                        <TextBlock Text="Theme" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" Width="160" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Theme" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="1" Padding="20,10" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Open settings file" Command="{Binding OpenFile}" Padding="12,5" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Undo changes" Command="{Binding Revert}" Padding="12,5" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Save" Command="{Binding Save}" Padding="20,5" IsDefault="True" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                               Visibility="{Binding Error, Converter={StaticResource NotNullToVisibility}}" />
                    <TextBlock Text="{Binding Saved}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap"
                               Visibility="{Binding Saved, Converter={StaticResource NotNullToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
