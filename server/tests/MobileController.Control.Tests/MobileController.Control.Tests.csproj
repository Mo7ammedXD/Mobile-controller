  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MobileController.Control\MobileController.Control.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
