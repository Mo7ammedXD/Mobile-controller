<UserControl x:Class="MobileController.Desktop.Views.ControllersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MobileController.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,4,20,20">
            <TextBlock Text="Controllers" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageIntro}"
                       Text="Every connected phone, what the game sees from it right now, and how good its link is. Identify makes the phone buzz and flash, so you can tell several phones apart." />

            <Border Style="{StaticResource Card}" Visibility="{Binding Pads.Count, Converter={StaticResource ZeroToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No phone is connected" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13"
                               Text="Open Mobile Controller on the phone and tap Find PC. The Connect a phone page shows this PC's address and a code to scan." />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Pads}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="470" Margin="0,0,12,12">
                            <StackPanel>
                                <!-- Who -->
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="0">
                                        <TextBlock Text="{Binding Quality, StringFormat={}{0} link}" FontSize="12" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- What the game sees -->
                                <controls:PadVisualizer Live="{Binding Live}" PlayStation="{Binding IsDualShock4}" Height="150" Margin="0,12,0,4"
                                                        Accent="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <!-- The link -->
                                <UniformGrid Columns="5" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Latency" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding LatencyText}" Style="{StaticResource MetricValue}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Updates" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding RateText}" Style="{StaticResource MetricValue}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Lost" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding LossText}" Style="{StaticResource MetricValue}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Jitter" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding JitterText}" Style="{StaticResource MetricValue}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Battery" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding BatteryText}" Style="{StaticResource MetricValue}" FontSize="15" />
                                    </StackPanel>
                                </UniformGrid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Latency, last 30 s" Style="{StaticResource MetricLabel}" />
                                        <controls:Sparkline Values="{Binding LatencyHistory}" Height="32" MinimumScale="10"
                                                            Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Updates per second" Style="{StaticResource MetricLabel}" />
                                        <controls:Sparkline Values="{Binding RateHistory}" Height="32" MinimumScale="120"
                                                            Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="This phone's app predates name, battery and latency reporting: update it to see them and to use Identify."
                                           Visibility="{Binding SupportsStatus, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                <!-- Controller type -->
                                <TextBlock Text="Appears to games as" Style="{StaticResource FormLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Xbox 360" Command="{Binding SetOutput}" CommandParameter="xbox360" Margin="0,0,8,0" Padding="12,5" />
                                    <Button Content="DualShock 4" Command="{Binding SetOutput}" CommandParameter="ds4" Margin="0,0,8,0" Padding="12,5" />
                                    <Button Content="Phone decides" Command="{Binding SetOutput}" CommandParameter="" Margin="0,0,8,0" Padding="12,5" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}">
                                        <Run Text="Now: " /><Run Text="{Binding KindText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Name -->
                                <TextBlock Text="Name on this PC" Style="{StaticResource FormLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Rename" Command="{Binding Rename}"
                                            CommandParameter="{Binding Text, ElementName=AliasBox}" Margin="8,0,0,0" Padding="12,4" />
                                    <TextBox x:Name="AliasBox" Text="{Binding AliasDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                             AutomationProperties.Name="Name on this PC" />
                                </DockPanel>

                                <!-- Actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Command="{Binding Identify}" Margin="0,0,8,0" Padding="12,5" ToolTip="The phone vibrates and flashes for 3 seconds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Identify" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RumbleTest}" Margin="0,0,8,0" Padding="12,5" ToolTip="Half a second of rumble on the phone">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE877;" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Test rumble" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding Disconnect}" Margin="0,0,8,0" Padding="12,5" ToolTip="Unplug this controller; the phone can reconnect after 30 seconds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="Disconnect" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                                    <Run Text="{Binding EndPoint, Mode=OneWay}" /><Run Text="  ·  connected for " /><Run Text="{Binding ConnectedText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
