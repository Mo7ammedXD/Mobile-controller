<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Nefarius.ViGEm.Client embeds vigemclient.dll for x86/x64 only. Pinning x64 also makes the app run
         (emulated) on Windows on ARM instead of failing to load the native client in an ARM64 process. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The steady state allocates nothing, so a background GC thread buys nothing. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <Version>1.0.0</Version>
    <Product>Mobile Controller</Product>
    <Description>Receives phone controller state over UDP and feeds a virtual Xbox 360 pad through ViGEmBus.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobileController.Control\MobileController.Control.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MobileController.Server.Tests" />
  </ItemGroup>

</Project>
