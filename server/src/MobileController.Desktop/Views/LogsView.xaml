<UserControl x:Class="MobileController.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Log" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageIntro}"
                       Text="What the server did: phones connecting and leaving, player numbers, games detected, and anything that went wrong. It is also written to a file (Open folder)." />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Width="190" Margin="0,0,8,0"
                      AutomationProperties.Name="Show" />
            <TextBox Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,8,0"
                     AutomationProperties.Name="Search the log" ToolTip="Search" />
            <CheckBox x:Name="Follow" Content="Follow new lines" IsChecked="True" VerticalAlignment="Center" Margin="4,0,16,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Copy" Command="{Binding CopyLogCommand}" Padding="12,4" />
                <Button Content="Clear view" Command="{Binding ClearLogCommand}" Padding="12,4" Margin="8,0,0,0" />
                <Button Content="Open folder" Command="{Binding OpenLogFolderCommand}" Padding="12,4" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
        <ListView x:Name="Lines" Grid.Row="2" ItemsSource="{Binding LogsView}" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" FontFamily="Cascadia Mono, Consolas" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="110" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss.fff}" />
                    <GridViewColumn Header="Level" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Level" Text="{Binding Level}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Message" Width="900">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
