<UserControl x:Class="MobileController.Desktop.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MobileController.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,4,20,20" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Connect a phone" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageIntro}"
                       Text="The phone and this PC must be on the same network: the same Wi-Fi, or the phone plugged in by USB with USB tethering on (the fastest and steadiest link)." />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:QrCode Text="{Binding Pairing.PairingUri}" Width="220" Height="220" VerticalAlignment="Top"
                                     AutomationProperties.Name="Code to scan with the phone's camera" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Three steps" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="1.  Install Mobile Controller on the phone and open it." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="2.  Tap the gear, then Find PC. Or scan this code with the phone's camera." />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Text="3.  Pick this PC. The phone vibrates and shows its player number when it is connected." />
                        <TextBlock Text="Or type it in" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Address" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Pairing.Address, FallbackValue=No network}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Port" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding Port}" FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Copy address" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Pairing.Address}"
                                    Margin="0,0,8,0" Padding="12,5" />
                            <Button Content="Copy link" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Pairing.PairingUri}"
                                    Margin="0,0,8,0" Padding="12,5" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                   Visibility="{Binding Firewall.ActionText, Converter={StaticResource NotNullToVisibility}}"
                                   Text="Not connecting? Windows Firewall may be blocking phones: allow them in the setup checklist on the Dashboard." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="This PC's network adapters" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                               Text="Any of the usable addresses works; the list updates when you join a network or turn on USB tethering." />
                    <ItemsControl ItemsSource="{Binding Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Address}" FontWeight="SemiBold" FontSize="15" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding Description, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Hint, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Copy" Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Address}" Padding="12,4"
                                            Visibility="{Binding Usable, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
