<Window x:Class="MobileController.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MobileController.Desktop.Views"
        Title="Mobile Controller"
        Icon="Assets/app.ico"
        Width="1120" Height="760" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Health banner: the one thing worth knowing right now, and what to do about it. -->
        <Border Grid.Row="0" Margin="12,12,12,0" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{Binding Health, Converter={StaticResource LevelToBrush}}" BorderThickness="0,0,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" FontSize="24" Margin="0,0,14,0"
                           Text="{Binding Health, Converter={StaticResource LevelToGlyph}}"
                           Foreground="{Binding Health, Converter={StaticResource LevelToBrush}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HealthTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HealthDetail}" Style="{StaticResource Caption}" FontSize="13"
                               Visibility="{Binding HealthDetail, Converter={StaticResource NotNullToVisibility}}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding HealthActionText}" Command="{Binding HealthAction}"
                        Padding="14,6" VerticalAlignment="Center"
                        Visibility="{Binding HealthActionText, Converter={StaticResource NotNullToVisibility}}" />
            </Grid>
        </Border>

        <TabControl x:Name="Pages" Grid.Row="1" Margin="12" TabStripPlacement="Left" SelectionChanged="OnPageChanged"
                    AutomationProperties.Name="Pages">
            <TabItem x:Name="DashboardPage" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Left">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,10,0" />
                        <TextBlock Text="Dashboard" />
                    </StackPanel>
                </TabItem.Header>
                <views:DashboardView />
            </TabItem>
            <TabItem x:Name="ControllersPage" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Left">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" Margin="0,0,10,0" />
                        <TextBlock Text="Controllers" />
                    </StackPanel>
                </TabItem.Header>
                <views:ControllersView />
            </TabItem>
            <TabItem x:Name="ConnectPage" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Left">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EA;" Margin="0,0,10,0" />
                        <TextBlock Text="Connect a phone" />
                    </StackPanel>
                </TabItem.Header>
                <views:ConnectView />
            </TabItem>
            <TabItem x:Name="DiagnosticsPage" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Left">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,10,0" />
                        <TextBlock Text="Diagnostics" />
                    </StackPanel>
                </TabItem.Header>
                <views:DiagnosticsView />
            </TabItem>
            <TabItem x:Name="LogsPage" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Left">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" Margin="0,0,10,0" />
                        <TextBlock Text="Log" />
                    </StackPanel>
                </TabItem.Header>
                <views:LogsView />
            </TabItem>
            <TabItem x:Name="SettingsPage" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Left">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,10,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
            <TabItem x:Name="HelpPage" Padding="12,8" MinWidth="170" HorizontalContentAlignment="Left">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE897;" Margin="0,0,10,0" />
                        <TextBlock Text="Help" />
                    </StackPanel>
                </TabItem.Header>
                <views:HelpView />
            </TabItem>
        </TabControl>

        <!-- Status line: the result of the last action, and versions. -->
        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Caption wraps; one line with an ellipsis keeps a long message clear of the versions. -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}" />
            <TextBlock Grid.Column="1" Text="{Binding ServerVersionText}" Style="{StaticResource Caption}" Margin="16,0,0,0" />
        </Grid>
    </Grid>
</Window>
